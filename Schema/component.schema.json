{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DirectedEdges/specs/specs-schema@0.35.0/packages/schema/schema/component.schema.json",
  "title": "Component specs (Specs 2 / Figma export)",
  "description": "Schema for component YAML files produced by Specs 2. Accepts design tokens as strings and resolved numbers/nulls.",
  "type": "object",
  "required": ["components"],
  "additionalProperties": false,
  "properties": {
    "components": {
      "type": "object",
      "minProperties": 1,
      "description": "Map: component key → component definition.",
      "additionalProperties": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "tokenOrNumber": {
      "description": "Design token string or resolved number.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "number" }
      ]
    },
    "tokenOrNumberOrNull": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "number" },
        { "type": "null" }
      ]
    },
    "tokenOrNull": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "scalar": {
      "type": ["string", "number", "boolean", "null"]
    },

    "component": {
      "type": "object",
      "required": ["title", "anatomy", "props", "default", "variants", "metadata"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "anatomy": {
          "type": "object",
          "required": ["root"],
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/anatomyNode" }
        },
        "props": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/prop" }
        },
        "default": { "$ref": "#/$defs/defaultState" },
        "variants": {
          "type": "array",
          "items": { "$ref": "#/$defs/variant" }
        },
        "invalidPropCombinations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/scalar" }
          }
        },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },

    "anatomyNode": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["container", "text", "rectangle", "instance"]
        },
        "detectedIn": {
          "type": "string",
          "description": "Variant in which the element appears, e.g. 'State=Active' or 'Size=sm, Shape=oval'."
        },
        "instanceOf": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "instance" } },
            "required": ["type"]
          },
          "then": { "required": ["instanceOf"] }
        }
      ]
    },

    "prop": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "boolean", "number"]
        },
        "default": { "$ref": "#/$defs/scalar" },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/scalar" }
        },
        "nullable": { "type": "boolean" },
        "examples": {
          "type": "array",
          "items": { "$ref": "#/$defs/scalar" }
        }
      }
    },

    "layoutNode": {
      "description": "Element name (string) or single-key object { parentName: [children...] }.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/layoutNode" }
          }
        }
      ]
    },
    "layout": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/layoutNode" }
    },

    "defaultState": {
      "type": "object",
      "required": ["layout", "elements"],
      "additionalProperties": false,
      "properties": {
        "layout": { "$ref": "#/$defs/layout" },
        "elements": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/element" }
        }
      }
    },

    "variant": {
      "type": "object",
      "required": ["configuration"],
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/scalar" }
        },
        "layout": { "$ref": "#/$defs/layout" },
        "elements": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/element" }
        }
      }
    },

    "element": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "styles": { "$ref": "#/$defs/styles" },
        "content": { "type": "string" },
        "instanceOf": { "type": "string" },
        "propConfigurations": {
          "type": "object",
          "description": "Prop values passed to a nested component instance.",
          "additionalProperties": { "$ref": "#/$defs/scalar" }
        }
      }
    },

    "sides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": { "$ref": "#/$defs/tokenOrNumber" },
        "bottom": { "$ref": "#/$defs/tokenOrNumber" },
        "start": { "$ref": "#/$defs/tokenOrNumber" },
        "end": { "$ref": "#/$defs/tokenOrNumber" }
      }
    },
    "corners": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topStart": { "$ref": "#/$defs/tokenOrNumber" },
        "topEnd": { "$ref": "#/$defs/tokenOrNumber" },
        "bottomEnd": { "$ref": "#/$defs/tokenOrNumber" },
        "bottomStart": { "$ref": "#/$defs/tokenOrNumber" }
      }
    },
    "shadow": {
      "type": "object",
      "required": ["color"],
      "additionalProperties": false,
      "properties": {
        "visible": { "type": "boolean" },
        "offsetX": { "type": "number" },
        "offsetY": { "type": "number" },
        "blur": { "type": "number", "minimum": 0 },
        "spread": { "type": "number" },
        "color": {
          "description": "Token string or hex color.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "fontSize": { "$ref": "#/$defs/tokenOrNumber" },
        "fontFamily": { "type": "string" },
        "fontStyle": { "type": "string" },
        "lineHeight": { "$ref": "#/$defs/tokenOrNumber" },
        "letterSpacing": { "$ref": "#/$defs/tokenOrNumber" },
        "textCase": { "type": "string" },
        "textDecoration": {
          "type": "string",
          "enum": ["NONE", "UNDERLINE", "STRIKETHROUGH"]
        },
        "paragraphIndent": { "type": "number" },
        "paragraphSpacing": { "type": "number" },
        "leadingTrim": { "type": "string" },
        "listSpacing": { "type": "number" },
        "hangingPunctuation": { "type": "boolean" },
        "hangingList": { "type": "boolean" }
      }
    },

    "styles": {
      "description": "Visual styles. Tokens (strings), numbers and nulls are all allowed to match Specs 2 export.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "visible": { "type": "boolean" },
        "clipsContent": { "type": "boolean" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },

        "width": { "$ref": "#/$defs/tokenOrNumber" },
        "height": { "$ref": "#/$defs/tokenOrNumber" },
        "aspectRatio": {
          "oneOf": [
            {
              "type": "object",
              "required": ["x", "y"],
              "additionalProperties": false,
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" }
              }
            },
            { "type": "null" }
          ]
        },

        "layoutMode": {
          "type": "string",
          "enum": ["HORIZONTAL", "VERTICAL", "NONE"]
        },
        "layoutSizingHorizontal": {
          "type": "string",
          "enum": ["HUG", "FILL", "FIXED"]
        },
        "layoutSizingVertical": {
          "type": "string",
          "enum": ["HUG", "FILL", "FIXED"]
        },
        "primaryAxisSizingMode": {
          "type": "string",
          "enum": ["FIXED", "AUTO"]
        },
        "mainAxisAlignment": {
          "type": "string",
          "enum": ["START", "CENTER", "END", "SPACE_BETWEEN", "BASELINE"]
        },
        "crossAxisAlignment": {
          "type": "string",
          "enum": ["START", "CENTER", "END", "SPACE_BETWEEN", "BASELINE"]
        },
        "itemSpacing": { "$ref": "#/$defs/tokenOrNumber" },

        "padding": {
          "oneOf": [
            { "$ref": "#/$defs/tokenOrNumber" },
            { "$ref": "#/$defs/sides" }
          ]
        },

        "position": {
          "type": "string",
          "enum": ["ABSOLUTE", "AUTO"]
        },
        "top": { "type": "number" },
        "start": { "type": "number" },

        "cornerRadius": {
          "oneOf": [
            { "$ref": "#/$defs/tokenOrNumber" },
            { "$ref": "#/$defs/corners" }
          ]
        },

        "backgroundColor": { "$ref": "#/$defs/tokenOrNull" },
        "strokes": { "$ref": "#/$defs/tokenOrNull" },
        "strokeAlign": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["INSIDE", "OUTSIDE", "CENTER"]
            },
            { "type": "null" }
          ]
        },
        "strokeWeight": { "$ref": "#/$defs/tokenOrNumberOrNull" },

        "effects": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "shadows": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/shadow" }
                }
              }
            },
            { "type": "null" }
          ]
        },

        "textColor": { "type": "string", "minLength": 1 },
        "textAlignHorizontal": {
          "type": "string",
          "enum": ["START", "CENTER", "END", "JUSTIFIED"]
        },
        "typography": { "$ref": "#/$defs/typography" }
      }
    },

    "metadata": {
      "type": "object",
      "required": ["author", "lastUpdated"],
      "additionalProperties": true,
      "properties": {
        "author": { "type": "string" },
        "lastUpdated": { "type": "string" },
        "generator": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "url": { "type": "string" },
            "version": { "type": "string" },
            "name": { "type": "string" },
            "license": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "status": { "type": "string" },
                "level": { "type": "string" }
              }
            }
          }
        },
        "schema": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "url": { "type": "string" },
            "version": { "type": "string" },
            "latest": { "type": "string" }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "pageId": { "type": "string" },
            "nodeId": { "type": "string" },
            "nodeType": { "type": "string" }
          }
        },
        "conventions": { "type": "object" },
        "settings": { "type": "object" }
      }
    }
  }
}
