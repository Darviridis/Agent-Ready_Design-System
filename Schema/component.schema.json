{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component.schema.json",
  "title": "Component specs",
  "description": "Schema for component YAML files (Specs 2 / Figma export). Root object holds one or more components.",
  "type": "object",
  "required": ["components"],
  "additionalProperties": false,
  "properties": {
    "components": {
      "type": "object",
      "minProperties": 1,
      "description": "Map: component key -> component definition.",
      "additionalProperties": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["title", "anatomy", "props", "default", "variants", "metadata"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "anatomy": {
          "type": "object",
          "required": ["root"],
          "description": "Map: element name -> element description. 'root' is mandatory.",
          "additionalProperties": { "$ref": "#/$defs/anatomyNode" }
        },
        "props": {
          "type": "object",
          "description": "Map: prop name -> prop definition.",
          "additionalProperties": { "$ref": "#/$defs/prop" }
        },
        "default": { "$ref": "#/$defs/defaultState" },
        "variants": {
          "type": "array",
          "items": { "$ref": "#/$defs/variant" }
        },
        "invalidPropCombinations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/scalar" }
          }
        },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },

    "scalar": { "type": ["string", "number", "boolean"] },

    "anatomyNode": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["container", "text", "rectangle", "instance"] },
        "detectedIn": {
          "type": "string",
          "description": "Variant in which the element appears, e.g. 'State=Active' or 'Type=Primary, State=Loading, Size=L'."
        },
        "instanceOf": { "type": "string" }
      },
      "if": { "properties": { "type": { "const": "instance" } }, "required": ["type"] },
      "then": { "required": ["instanceOf"] }
    },

    "prop": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["string", "boolean", "number"] },
        "default": { "$ref": "#/$defs/scalar" },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/scalar" }
        },
        "nullable": { "type": "boolean" },
        "examples": {
          "type": "array",
          "items": { "$ref": "#/$defs/scalar" }
        }
      }
    },

    "layoutNode": {
      "description": "Either an element name, or an object { parentName: [children...] }.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/layoutNode" }
          }
        }
      ]
    },
    "layout": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/layoutNode" }
    },

    "defaultState": {
      "type": "object",
      "required": ["layout", "elements"],
      "additionalProperties": false,
      "properties": {
        "layout": { "$ref": "#/$defs/layout" },
        "elements": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/element" }
        }
      }
    },

    "variant": {
      "type": "object",
      "required": ["configuration"],
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "type": "object",
          "minProperties": 1,
          "description": "Map: prop name -> value. Must reference props of the component.",
          "additionalProperties": { "$ref": "#/$defs/scalar" }
        },
        "layout": { "$ref": "#/$defs/layout" },
        "elements": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/element" }
        }
      }
    },

    "element": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "styles": { "$ref": "#/$defs/styles" },
        "content": { "type": "string" },
        "instanceOf": { "type": "string" },
        "propConfigurations": {
          "type": "object",
          "description": "Prop values passed to a nested component instance.",
          "additionalProperties": { "$ref": "#/$defs/scalar" }
        }
      }
    },

    "color": {
      "type": "string",
      "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
    },
    "nullableColor": {
      "oneOf": [{ "$ref": "#/$defs/color" }, { "type": "null" }]
    },
    "sizingMode": { "enum": ["HUG", "FILL", "FIXED"] },
    "axisAlignment": { "enum": ["START", "CENTER", "END", "SPACE_BETWEEN", "BASELINE"] },

    "sides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": { "type": "number" },
        "bottom": { "type": "number" },
        "start": { "type": "number" },
        "end": { "type": "number" }
      }
    },
    "corners": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topStart": { "type": "number" },
        "topEnd": { "type": "number" },
        "bottomEnd": { "type": "number" },
        "bottomStart": { "type": "number" }
      }
    },

    "shadow": {
      "type": "object",
      "required": ["color"],
      "additionalProperties": false,
      "properties": {
        "visible": { "type": "boolean" },
        "offsetX": { "type": "number" },
        "offsetY": { "type": "number" },
        "blur": { "type": "number", "minimum": 0 },
        "spread": { "type": "number" },
        "color": { "$ref": "#/$defs/color" }
      }
    },

    "typography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontSize": { "type": "number", "exclusiveMinimum": 0 },
        "fontFamily": { "type": "string" },
        "fontStyle": { "type": "string" },
        "lineHeight": { "type": "number", "exclusiveMinimum": 0 },
        "letterSpacing": { "type": "number" },
        "textCase": { "type": "string" },
        "textDecoration": { "enum": ["NONE", "UNDERLINE", "STRIKETHROUGH"] },
        "paragraphIndent": { "type": "number" },
        "paragraphSpacing": { "type": "number" },
        "leadingTrim": { "type": "string" },
        "listSpacing": { "type": "number" },
        "hangingPunctuation": { "type": "boolean" },
        "hangingList": { "type": "boolean" }
      }
    },

    "styles": {
      "description": "Known style properties are typed; unknown ones are allowed (additionalProperties: true) so new generator fields do not break validation.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "visible": { "type": "boolean" },
        "clipsContent": { "type": "boolean" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },

        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "aspectRatio": {
          "oneOf": [
            {
              "type": "object",
              "required": ["x", "y"],
              "additionalProperties": false,
              "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
            },
            { "type": "null" }
          ]
        },

        "layoutMode": { "enum": ["HORIZONTAL", "VERTICAL", "NONE"] },
        "layoutSizingHorizontal": { "$ref": "#/$defs/sizingMode" },
        "layoutSizingVertical": { "$ref": "#/$defs/sizingMode" },
        "primaryAxisSizingMode": { "enum": ["FIXED", "AUTO"] },
        "mainAxisAlignment": { "$ref": "#/$defs/axisAlignment" },
        "crossAxisAlignment": { "$ref": "#/$defs/axisAlignment" },
        "itemSpacing": { "type": "number" },
        "padding": {
          "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/sides" }]
        },

        "position": { "enum": ["ABSOLUTE", "AUTO"] },
        "top": { "type": "number" },
        "start": { "type": "number" },

        "cornerRadius": {
          "oneOf": [{ "type": "number", "minimum": 0 }, { "$ref": "#/$defs/corners" }]
        },

        "backgroundColor": { "$ref": "#/$defs/nullableColor" },
        "strokes": { "$ref": "#/$defs/nullableColor" },
        "strokeAlign": { "enum": ["INSIDE", "OUTSIDE", "CENTER", null] },
        "strokeWeight": { "type": ["number", "null"], "minimum": 0 },

        "effects": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shadows": { "type": "array", "items": { "$ref": "#/$defs/shadow" } }
          }
        },

        "textColor": { "$ref": "#/$defs/color" },
        "textAlignHorizontal": { "enum": ["START", "CENTER", "END", "JUSTIFIED"] },
        "typography": { "$ref": "#/$defs/typography" }
      }
    },

    "metadata": {
      "type": "object",
      "required": ["author", "lastUpdated"],
      "additionalProperties": true,
      "properties": {
        "author": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date-time" },
        "generator": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "version": { "type": "string" },
            "name": { "type": "string" },
            "license": {
              "type": "object",
              "properties": {
                "status": { "type": "string" },
                "level": { "type": "string" }
              }
            }
          }
        },
        "schema": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "version": { "type": "string" },
            "latest": { "type": "string", "format": "uri" }
          }
        },
        "source": {
          "type": "object",
          "properties": {
            "pageId": { "type": "string" },
            "nodeId": { "type": "string" },
            "nodeType": { "type": "string" }
          }
        },
        "conventions": { "type": "object" },
        "settings": { "type": "object" }
      }
    }
  }
}
